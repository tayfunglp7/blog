@inject SiteAyarlari Site
@{
    var yol = Context.Request.Path.Value?.ToLowerInvariant() ?? "";

    // Menüde hangi öğe aktif? Yol parçasına bakıyoruz.
    string Aktif(string parca) => yol.Contains("/" + parca) ? "active" : "";

    
}

@inject BlogDbContext Db
@{
    var okunmamisMesaj = Db.Mesajlar.Count(m => !m.OkunduMu);
    var taslakYazi = Db.Yazilar.Count(y => y.Durum == YaziDurum.Taslak);
    // ... mevcut kod
}

<!DOCTYPE html>
<html lang="tr">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — Yönetim</title>

    @* ⭐ Yönetim paneli arama motorlarına kapalı *@
    <meta name="robots" content="noindex, nofollow" />

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@@1.11.3/font/bootstrap-icons.css" rel="stylesheet">

    @* ⚠️ site.css'i BİLEREK yüklemiyoruz.
         Panel Bootstrap'in standart görünümünde kalsın. *@
</head>

<body class="bg-body-tertiary">

    <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
        <div class="container-fluid">

            <a class="navbar-brand" asp-controller="Panel" asp-action="Index">
                <i class="bi bi-journal-text me-1"></i> @Site.Baslik
            </a>

            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#panelMenu"
                    aria-controls="panelMenu" aria-expanded="false" aria-label="Menüyü aç kapat">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="panelMenu">

                <ul class="navbar-nav me-auto">
                    <li class="nav-item">
                        <a class="nav-link @(yol == "/yonetim" || yol == "/yonetim/" ? "active" : "")"
                           asp-controller="Panel" asp-action="Index">Panel</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @Aktif("yazi")" asp-controller="YaziYonetim" asp-action="Index">Yazılar</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @Aktif("sayfa")" asp-controller="SayfaYonetim"
                           asp-action="Index">Sayfalar</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @Aktif("etiket")" asp-controller="EtiketYonetim"
                           asp-action="Index">Etiketler</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link d-flex align-items-center gap-2 @Aktif("yazi")" asp-controller="YaziYonetim"
                           asp-action="Index">
                            Yazılar
                            @if (taslakYazi > 0)
                            {
                                <span class="badge text-bg-secondary">@taslakYazi</span>
                            }
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link d-flex align-items-center gap-2 @Aktif("mesaj")"
                           asp-controller="MesajYonetim" asp-action="Index">
                            Mesajlar
                            @if (okunmamisMesaj > 0)
                            {
                                <span class="badge text-bg-danger">@okunmamisMesaj</span>
                            }
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link @Aktif("abone")" asp-controller="MesajYonetim"
                           asp-action="Aboneler">Aboneler</a>
                    </li>
                </ul>

                <ul class="navbar-nav">
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Anasayfa" asp-action="Index" target="_blank" rel="noopener">
                            Siteyi gör <i class="bi bi-box-arrow-up-right small"></i>
                        </a>
                    </li>
                    <li class="nav-item d-flex align-items-center">
                        <span class="navbar-text me-2">@User.Identity?.Name</span>
                        <form asp-controller="Hesap" asp-action="Cikis" method="post" class="d-inline">
                            <button type="submit" class="btn btn-sm btn-outline-light">
                                Çıkış
                            </button>
                        </form>
                    </li>
                </ul>

            </div>
        </div>
    </nav>

    <div class="container-fluid px-4 py-4">

        <div class="d-flex justify-content-between align-items-center mb-4">
            <h1 class="h3 mb-0">@ViewData["Title"]</h1>
            @await RenderSectionAsync("BaslikEylem", required: false)
        </div>

        @* Bildirimler — tüm panel sayfalarında ortak *@
        @if (TempData["Basarili"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show">
                <i class="bi bi-check-circle me-1"></i> @TempData["Basarili"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Kapat"></button>
            </div>
        }
        @if (TempData["Uyari"] != null)
        {
            <div class="alert alert-warning alert-dismissible fade show">
                <i class="bi bi-exclamation-triangle me-1"></i> @TempData["Uyari"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Kapat"></button>
            </div>
        }
        @if (TempData["Hata"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show">
                <i class="bi bi-x-circle me-1"></i> @TempData["Hata"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Kapat"></button>
            </div>
        }

        @RenderBody()

    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)

</body>

</html>