@inject SiteAyarlari Site
@{
    var sayfaBasligi = ViewData["Title"] as string;
    var tamBaslik = string.IsNullOrEmpty(sayfaBasligi)
        ? Site.Baslik
        : $"{sayfaBasligi} — {Site.Baslik}";

    var aciklama = ViewData["Aciklama"] as string ?? Site.Aciklama;
}

<!DOCTYPE html>
<html lang="tr">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@tamBaslik</title>
    <meta name="description" content="@aciklama" />

    @* Sosyal medya paylaşım önizlemesi *@
    <meta property="og:title" content="@tamBaslik" />
    <meta property="og:description" content="@aciklama" />
    <meta property="og:type" content="website" />

    @* ── Yazı tipleri ── *@
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link
    href="https://fonts.googleapis.com/css2?family=Montserrat:wght@@700;800&family=Lato:wght@@400;700&display=swap"
    rel="stylesheet">

    @* ── Bootstrap ── *@
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@@1.11.3/font/bootstrap-icons.css" rel="stylesheet">

    @* ── Bizim katmanımız — EN SONDA ── *@
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    @await RenderSectionAsync("Head", required: false)

    <link rel="alternate" type="application/rss+xml" title="@Site.Baslik — RSS" href="/rss" />

    @{
        var kanonik = $"{Context.Request.Scheme}://{Context.Request.Host}" +
                      $"{Context.Request.Path}";
    }
    <link rel="canonical" href="@kanonik" />
</head>

<body>

    @* ══════ MOBİL ÜST ÇUBUK — sadece küçük ekranda ══════ *@
    <div class="d-lg-none d-flex justify-content-between align-items-center
        px-3 py-2 border-bottom" style="background: var(--yan-zemin);">
        <a href="/" class="h6 mb-0 text-decoration-none" style="color: var(--bs-heading-color);">@Site.AdSoyad</a>

        <button class="btn btn-sm btn-outline-secondary border-0" type="button" data-bs-toggle="collapse"
                data-bs-target="#yanSutun" aria-expanded="false" aria-controls="yanSutun" aria-label="Menüyü aç kapat">
            <i class="bi bi-list fs-5"></i>
        </button>
    </div>

    <div class="container-fluid">
        <div class="row">

            @* ══════ YAN SÜTUN ══════ *@
            <aside id="yanSutun" class="col-lg-3 yan-sutun p-4 collapse d-lg-block">
                <partial name="_YanSutun" />
            </aside>

            @* ══════ İÇERİK ══════ *@
            <main class="col-lg-9 p-4 p-lg-5">
                <div class="icerik-alani">
                    @RenderBody()
                </div>
            </main>

        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)

</body>

</html>